{
  "manifest_version": 3,
  "name": "DNS64 Browser Extension",
  "version": "1.4.4",
  "description": "Blocklisten von DNS64 (Node64) schalten, Domains freigeben oder sperren.",
  "action": {
    "default_title": "DNS64 Browser Extension",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
